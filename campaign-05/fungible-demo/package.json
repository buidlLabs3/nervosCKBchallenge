    "proof": "node token-flow.mjs"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.5.3"
  },
  "devDependencies": {
    "events": "^3.3.0",
    "parcel": "2.15.4",
    "playwright": "1.61.1",
    "process": "0.11.10",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0"
  }
}
