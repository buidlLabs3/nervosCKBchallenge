{
  "name": "buidllabs3-workshop-credits",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local xUDT workshop for Build on CKB Campaign 05",
  "scripts": {
    "start": "parcel workshop.html --host 127.0.0.1 --port 1252",
